# Copy this file to `.env` and fill in your values. `.env` is gitignored.
# Generate an API key in Trading 212 → Settings → API (Beta).

# REQUIRED — your Trading 212 API key and secret. Trading 212 uses HTTP Basic
# auth, so BOTH must be set. Do NOT commit real values.
TRADING212_API_KEY=your_key_here
TRADING212_SECRET_KEY=your_secret_here

# Environment to target. `live` (default) or `demo`.
# A `live` key only works against the live host, and likewise for demo.
TRADING212_ENV=live

# Optional — full base URL override. Wins over TRADING212_ENV when set.
# TRADING212_BASE_URL=https://live.trading212.com

# Opt-in safety flag. Set to `1` (or `true`) to register write tools
# (place/cancel orders, create/update/delete pies, request exports).
# Leave unset for a read-only server.
TRADING212_ALLOW_WRITES=0

# Optional — request timeout in seconds. Default 30.
# TRADING212_TIMEOUT_SECONDS=30
